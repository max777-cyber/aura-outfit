spring.application.name=aura-outfit
server.port=8080

# ─── Banco de dados MySQL ────────────────────────────────────────
spring.datasource.url=jdbc:mysql://localhost:3306/aura_outfit?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
spring.datasource.username=SEU_USUARIO_MYSQL
spring.datasource.password=SUA_SENHA_MYSQL
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver

spring.jpa.hibernate.ddl-auto=update
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.MySQLDialect

# ─── Sessão ──────────────────────────────────────────────────────
server.servlet.session.cookie.same-site=lax
server.servlet.session.cookie.http-only=true
server.servlet.session.cookie.secure=false
server.servlet.session.timeout=2h

# ─── CORS ────────────────────────────────────────────────────────
app.cors.allowed-origins=http://localhost:8080,http://127.0.0.1:8080

# ─── Frontend URL ────────────────────────────────────────────────
app.frontend.url=http://localhost:8080

# ─── Admin padrão ────────────────────────────────────────────────
app.admin.email=adm@aura.local
app.admin.senha=admin123
app.admin.nome=Administrador

# ─── Mercado Pago ────────────────────────────────────────────────
# Obtenha em: https://www.mercadopago.com.br/developers/panel
# Use credenciais de TESTE em desenvolvimento
app.email.from=no-reply@aura.local
spring.mail.host=
spring.mail.port=587
spring.mail.username=
spring.mail.password=
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true

mercadopago.access-token=
# ─── Logging ─────────────────────────────────────────────────────
logging.level.com.aura=INFO
logging.level.com.mercadopago=WARN

# Google Login. Crie as credenciais no Google Cloud Console.
# Redirect URI local: http://localhost:8080/login/oauth2/code/google
spring.security.oauth2.client.registration.google.client-id=${GOOGLE_CLIENT_ID:configure-google-client-id}
spring.security.oauth2.client.registration.google.client-secret=${GOOGLE_CLIENT_SECRET:configure-google-client-secret}
spring.security.oauth2.client.registration.google.scope=openid,email,profile