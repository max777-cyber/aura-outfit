# ============================================================
#  AURA OUTFIT — variáveis de ambiente (desenvolvimento local)
#  NÃO commite este arquivo no git!
# ============================================================

# --- Banco de dados (H2 local) ---
SPRING_DATASOURCE_URL=jdbc:h2:file:/app/data/aura_outfit;MODE=MySQL;DATABASE_TO_LOWER=TRUE;DB_CLOSE_DELAY=-1
SPRING_DATASOURCE_USERNAME=sa
SPRING_DATASOURCE_PASSWORD=
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.h2.Driver
JPA_PLATFORM=org.hibernate.dialect.H2Dialect

# --- Servidor ---
APP_FRONTEND_URL=http://localhost:8080
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Admin padrão (altere antes de ir para produção!) ---
APP_ADMIN_EMAIL=adm@aura.local
APP_ADMIN_SENHA=admin123
APP_ADMIN_NOME=Administrador

# --- Email / SMTP (deixe vazio para ver links no terminal) ---
APP_EMAIL_FROM=no-reply@aura.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# --- Mercado Pago ---
MERCADOPAGO_ACCESS_TOKEN=

# --- Google OAuth2 ---
GOOGLE_CLIENT_ID=configure-google-client-id
GOOGLE_CLIENT_SECRET=configure-google-client-secret

# --- Segurança ---
# false em HTTP local; true em HTTPS (produção)
SESSION_COOKIE_SECURE=false
H2_CONSOLE_ENABLED=false
